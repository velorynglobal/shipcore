# ============================================================
# ShipCore - Environment Variables
# Copy this to .env.local and fill in values
# NEVER commit .env.local to version control
# ============================================================

# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ShipCore
NEXT_PUBLIC_APP_VERSION=1.0.0

# Email (Resend or SMTP)
RESEND_API_KEY=re_your_resend_api_key

# WhatsApp (optional - via Twilio or WATI)
WHATSAPP_API_URL=https://api.wati.io/v1
WHATSAPP_API_TOKEN=your-whatsapp-token

# Storage (for file uploads)
NEXT_PUBLIC_STORAGE_BUCKET=shipcore-docs

# Feature Flags
NEXT_PUBLIC_ENABLE_WHATSAPP=false
NEXT_PUBLIC_ENABLE_EMAIL=true

# AI providers (configure at least one)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.7-flash
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
AI_MOCK_MODE=false
AI_MOCK_ON_QUOTA=false

# Agent runtime (required for Supabase Edge Functions)
AGENT_INTERNAL_SECRET=generate-a-random-64-character-secret
AGENT_CRON_SECRET=generate-a-different-random-64-character-secret
